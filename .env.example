# Copy to .env.local and fill in. Never commit real values.
# Local values: run `pnpm db:status` after `pnpm db:start`.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: public, safe in the browser (all access is enforced by RLS)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase: SERVER ONLY, bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
