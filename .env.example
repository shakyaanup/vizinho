# Copy to .env.local and fill in. Never commit real values.
# Local values are printed by `supabase status` (Step 3).

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: public (safe in the browser, protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase: SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
