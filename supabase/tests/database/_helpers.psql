-- Shared pgTAP helpers. Included by each test file with `\ir _helpers.psql`.
-- The .psql extension keeps pg_prove from running this file as a test.
-- Everything here lives inside the test's transaction and is rolled back.

create extension if not exists pgtap with schema extensions;

create schema tests;
grant usage on schema tests to anon, authenticated;

-- Creates an auth user; the on_auth_user_created trigger adds profile + role.
create function tests.create_user(p_email text, p_metadata jsonb default '{}'::jsonb)
returns uuid
language plpgsql
as $$
declare
  v_id uuid := gen_random_uuid();
begin
  insert into auth.users (
    id, instance_id, aud, role, email, encrypted_password,
    raw_app_meta_data, raw_user_meta_data, email_confirmed_at, created_at, updated_at
  ) values (
    v_id, '00000000-0000-0000-0000-000000000000', 'authenticated', 'authenticated', p_email, '',
    '{"provider":"email","providers":["email"]}', p_metadata, now(), now(), now()
  );
  return v_id;
end;
$$;

-- Act as a signed-in user: switch to the `authenticated` role and set the JWT
-- claims that auth.uid() reads. Undo with a plain `reset role;`.
create function tests.authenticate_as(p_user_id uuid)
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims',
    json_build_object('sub', p_user_id, 'role', 'authenticated')::text, true);
  perform set_config('role', 'authenticated', true);
end;
$$;

-- Set auth.uid() without switching role (to call private helpers as a user).
create function tests.set_uid(p_user_id uuid)
returns void
language sql
as $$
  select set_config('request.jwt.claims',
    json_build_object('sub', p_user_id, 'role', 'authenticated')::text, true);
$$;

create function tests.make_admin(p_user_id uuid)
returns void
language sql
as $$
  insert into public.user_roles (user_id, role) values (p_user_id, 'admin');
$$;

-- An approved host near Arroios, Lisbon, with weekday hours. Runs as postgres.
create function tests.create_approved_host(p_owner uuid, p_name text default 'Test Host')
returns uuid
language plpgsql
as $$
declare
  v_host uuid;
begin
  insert into public.host_profiles (user_id, display_name, status, area_label)
  values (p_owner, p_name, 'approved', 'Arroios, Lisboa')
  returning id into v_host;

  insert into public.host_private_details (host_id, address_line1, postal_code, city, exact_location)
  values (v_host, 'Rua de Arroios 10', '1150-054', 'Lisboa',
          extensions.st_setsrid(extensions.st_makepoint(-9.1349, 38.7316), 4326)::extensions.geography);

  insert into public.host_weekly_hours (host_id, weekday, opens_at, closes_at)
  select v_host, d, '09:00', '19:00' from generate_series(1, 5) d;

  insert into public.user_roles (user_id, role) values (p_owner, 'host');
  return v_host;
end;
$$;

create function tests.create_reservation(p_customer uuid, p_host uuid)
returns uuid
language sql
as $$
  insert into public.reservations (
    customer_id, host_id, expected_delivery_date, declared_size,
    declared_value_cents, prohibited_items_attested_at
  ) values (p_customer, p_host, current_date + 3, 'small', 4500, now())
  returning id;
$$;

grant execute on all functions in schema tests to anon, authenticated;
